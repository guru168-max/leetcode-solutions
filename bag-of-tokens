class Solution {
public:
    int bagOfTokensScore(vector<int>& tokens, int power) {
        int score=0;
        sort(tokens.begin(),tokens.end());
        int start=0;
        int maxScore=0;
        int end=tokens.size()-1;
        while(start<=end)
        {
            if(power>=tokens[start])
            {
                power-=tokens[start];
                start++;
                score++;
                maxScore = max(maxScore, score);
            }
            else if(score > 0)
            {
                power+=tokens[end];
                end--;
                score--;
            }
            else
            {
                break;
            }
        }
        return maxScore;
        
    }
};
