class Solution {
public:
    vector<int> partitionLabels(string s) {
        vector<int>ans;
        vector<int>stored(26,0);
        for(auto it:s) stored[it-'a']++;
        unordered_set<char>active;
        int start=0;
        for(int i=0; i<s.size(); i++)
        {
            //insert in the set
            active.insert(s[i]);

            //now this one we used so count must be decrese
            stored[s[i]-'a']--;

            //when count ==0 mean this would be delete from the set
            if(stored[s[i]-'a']==0)
            active.erase(s[i]);

            //if the set empty mean this will be all exhausted which stored in the set
            if(active.empty())
            {
                //store that range in the ans
                ans.push_back(i-start+1);
                //next person/char
                start=i+1;
            }

        }
        return ans;
    }
};
